# ─── Editor / IDE ───────────────────────────────────────────
# La config local de Claude Code no se versiona, pero las skills sí:
# son documentación del proyecto y deben viajar entre equipos.
# Tiene que ser `.claude/*` y no `.claude/`: git no entra en un
# directorio excluido, así que desde `.claude/` el `!` no reincluiría nada.
.claude/*
!.claude/skills/
.vscode/
.idea/
.DS_Store

# ─── Node / Vite ────────────────────────────────────────────
node_modules/
dist/
dev-dist/
.vite/
*.log
.env
.env.local

# ─── Tests ──────────────────────────────────────────────────
# Playwright outputs (videos, screenshots, error contexts)
test-results/
playwright-report/
.playwright/
# Vitest coverage
coverage/
# Reportes y dumps de auditoría axe / debug
a11y-out.txt
a11y-results.json
a11y-summary.txt

# ─── Backups y assets locales ───────────────────────────────
backup/
src/img/reference-design/
